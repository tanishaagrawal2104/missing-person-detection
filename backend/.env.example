APP_NAME=Missing Person Detection API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/missing_person
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=5242880
UPLOAD_DIRECTORY=uploads
RATE_LIMIT_PER_MINUTE=10
FACE_DETECTOR_WEIGHTS=weights/yolov8n-face.pt
DEEPFACE_MODEL_NAME=Facenet512
DEEPFACE_DETECTOR_BACKEND=skip
FACE_MATCH_DISTANCE_THRESHOLD=0.30
VIDEO_FRAME_INTERVAL_SECONDS=1.0
MAX_VIDEO_SIZE_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=300
AI_IMAGE_SIZE=640
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_RECIPIENT_ROLES=admin,authorized_user
MAX_IMPORT_SIZE_BYTES=10485760
